# Server
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database - local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/cv-analyzer
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cv-analyzer?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# xAI / Grok - get a key at https://console.x.ai
# Uses the OpenAI-compatible endpoint https://api.x.ai/v1/chat/completions
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.7
AI_TIMEOUT_MS=90000

# Optional xAI tuning
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_REASONING_EFFORT=low
# XAI_TEMPERATURE=0.2
# XAI_MAX_RETRIES=2

# OCR for image uploads (tesseract.js) - e.g. 'eng' or 'eng+fra'
OCR_LANGS=eng
OCR_TIMEOUT_MS=60000
